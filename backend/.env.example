PORT=3000
# En Neon/Render, prefiera la URL completa. Si se define, reemplaza DB_USER...DB_PORT.
DATABASE_URL=
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=core_rrhh
DB_PASSWORD=change-this-value
DB_PORT=5432
# DB_SSL=true para conexiones remotas que requieren TLS; vacío usa TLS automáticamente con DATABASE_URL.
DB_SSL=
JWT_SECRET=change-this-secret-to-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
TRUST_PROXY=false
LOG_REQUESTS=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
GOOGLE_ALLOWED_DOMAIN=gla.edu.co
INSTITUTION_NAME=Gimnasio Los Arrayanes Bilingüe
INSTITUTION_CITY=Bogotá D.C.
# INSTITUTION_CONTACT=Teléfono o correo institucional autorizado

# Opcional: crea un administrador inicial durante npm run init-db.
# Retire SEED_ADMIN_PASSWORD del entorno después de crear la cuenta.
SEED_ADMIN_EMAIL=admin@gla.edu.co
SEED_ADMIN_PASSWORD=change-this-password-12

GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
